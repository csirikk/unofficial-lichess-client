{
	"name": "template-react-ts",
	"private": true,
	"version": "1.0.0",
	"description": "React + TypeScript + Vite + Tailwind CSS + ESLint + Prettier + Husky + Lint-Staged Template",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/YousifAbozid/template-react-ts.git"
	},
	"scripts": {
		"dev": "vite",
		"generate": "orval",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint --ext .js,.jsx,.ts,.tsx src",
		"lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src --fix",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
		"format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
		"fix-all": "npm run lint:fix && npm run format",
		"type-check": "tsc --noEmit --incremental",
		"upgrade": "npx npm-check-updates -u && npm install",
		"prepare": "husky"
	},
	"keywords": [],
	"author": "Yousif Abozid",
	"license": "MIT",
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"can-ndjson-stream": "^1.0.2",
		"chess.js": "^1.4.0",
		"lucide-react": "^0.563.0",
		"preline": "^3.2.3",
		"react": "^19.2.3",
		"react-chessboard": "^5.8.6",
		"react-dom": "^19.2.3",
		"react-router-dom": "^7.13.0",
		"tailwindcss": "^4.1.18",
		"use-local-storage": "^3.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.12",
		"@eslint/compat": "^2.0.1",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@redocly/cli": "^2.14.9",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.26",
		"globals": "^17.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"orval": "^8.0.3",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"terser": "^5.46.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.53.1",
		"vite": "^7.3.1"
	},
	"overrides": {
		"ajv": "8.17.1",
		"tsconfck": "2.1.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	}
}
