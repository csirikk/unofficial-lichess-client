{
	"name": "unofficial-lichess-client",
	"private": true,
	"version": "1.0.0",
	"description": "An unofficial real-time Lichess client built with React, TypeScript, Vite, and typed API generation.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"generate": "orval",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome lint ./src",
		"lint:fix": "biome lint --write ./src",
		"format": "biome format --write ./src",
		"format:check": "biome format ./src",
		"fix-all": "biome check --write ./src",
		"type-check": "tsc --noEmit --incremental",
		"upgrade": "bunx npm-check-updates -u && bun install",
		"prepare": "husky"
	},
	"keywords": [
		"react",
		"typescript",
		"vite",
		"lichess",
		"chess",
		"oauth",
		"openapi"
	],
	"author": "Matus Csirik",
	"license": "MIT",
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"can-ndjson-stream": "^1.0.2",
		"chess.js": "^1.4.0",
		"lucide-react": "^0.563.0",
		"preline": "^4.0.1",
		"react": "^19.2.4",
		"react-chessboard": "^5.8.6",
		"react-dom": "^19.2.4",
		"react-router-dom": "^7.13.0",
		"tailwindcss": "^4.1.18",
		"use-local-storage": "^3.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@redocly/cli": "^2.15.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"orval": "^8.2.0",
		"terser": "^5.46.0",
		"typescript": "~5.9.3",
		"vite": "^7.3.1"
	},
	"overrides": {
		"ajv": "8.17.1",
		"tsconfck": "2.1.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
